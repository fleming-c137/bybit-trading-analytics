# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# Create a READ-ONLY API key at https://www.bybit.com/app/user/api-management
#   - Permissions: "Read-Only" only (no Trade, no Withdraw, no Transfer)
#   - Restrict it to your IP address if you can
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to true to use https://api-testnet.bybit.com instead of mainnet
BYBIT_TESTNET=false

# Where synced data is stored (SQLite)
BYBIT_DB_PATH=data/bybit.db
